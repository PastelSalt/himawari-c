{
  "name": "himawari-mcp",
  "version": "0.0.0",
  "description": "MCP server for Himawari projects (spec 2026-07-28): read, validate, edit by line ID, playtest",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./studio-link": {
      "types": "./dist/studio-link.d.ts",
      "default": "./dist/studio-link.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "bin": {
    "himawari-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@himawari/core": "workspace:*",
    "@himawari/tools": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  }
}
