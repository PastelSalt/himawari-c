{
  "name": "@himawari/tools",
  "version": "0.0.0",
  "description": "The Himawari AI tool registry: every tool defined once (Zod schema + handler), exported as MCP tools and as SDK tools (plan §10.9)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@himawari/core": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
