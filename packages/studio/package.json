{
  "name": "@himawari/studio",
  "version": "0.4.0",
  "private": true,
  "description": "Himawari Studio, the authoring app (Electron + React + CodeMirror 6)",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "check:i18n": "node scripts/check-locales.mjs",
    "package": "electron-vite build && node scripts/stage-resources.mjs && electron-builder --win --config electron-builder.yml",
    "stage": "node scripts/stage-resources.mjs",
    "e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@himawari/core": "workspace:*",
    "@himawari/tools": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "ag-psd": "31.0.3",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "elkjs": "0.12.0",
    "fflate": "0.8.3",
    "himawari-mcp": "workspace:*",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.4",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "author": "Moesoft"
}
