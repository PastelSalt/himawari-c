{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc" }
    },
    {
      "name": "win64-debug",
      "displayName": "Windows debug (MSYS2 UCRT64)",
      "description": "Everyday build: -O0 -g, console subsystem.",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win64-release",
      "displayName": "Windows release (shipping build)",
      "description": "-Os + LTO, -static -static-libgcc -mwindows -s (size budget, plan §8.1).",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-Os -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-Os -DNDEBUG",
        "HW_RELEASE_STATIC": "ON"
      }
    },
    {
      "name": "win64-asan",
      "displayName": "Windows ASan/UBSan (MSYS2 CLANG64)",
      "description": "Needs C:\\msys64\\clang64\\bin first on PATH. Verified 2026-10-17 (plan §14.3).",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "clang", "HW_SANITIZE": "ON" }
    },
    {
      "name": "win64-fuzz",
      "displayName": "Windows libFuzzer targets (MSYS2 CLANG64)",
      "description": "Needs C:\\msys64\\clang64\\bin first on PATH. Verified 2026-10-17 (plan §14.3).",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "HW_FUZZ": "ON",
        "HW_WITH_SDL": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "win64-debug", "configurePreset": "win64-debug" },
    { "name": "win64-release", "configurePreset": "win64-release" },
    { "name": "win64-asan", "configurePreset": "win64-asan" },
    { "name": "win64-fuzz", "configurePreset": "win64-fuzz" }
  ],
  "testPresets": [
    { "name": "win64-debug", "configurePreset": "win64-debug", "output": { "outputOnFailure": true } },
    { "name": "win64-release", "configurePreset": "win64-release", "output": { "outputOnFailure": true } },
    { "name": "win64-asan", "configurePreset": "win64-asan", "output": { "outputOnFailure": true } },
    { "name": "win64-fuzz", "configurePreset": "win64-fuzz", "output": { "outputOnFailure": true } }
  ]
}
