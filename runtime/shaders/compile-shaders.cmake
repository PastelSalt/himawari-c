# Compiles runtime/shaders/*.frag.hlsl to DXIL (D3D12) and SPIR-V (Vulkan) and
# writes C headers to runtime/shaders/generated/. The headers are committed, so
# normal builds and CI never need a shader compiler (rfcs/0002).
#
# Usage, from runtime/:
#   cmake -DDXC=<path to dxc.exe> -P shaders/compile-shaders.cmake
#
# DXC: Microsoft DirectX Shader Compiler, https://github.com/microsoft/DirectXShaderCompiler/releases
# (Spike B used v1.9.2609.)

if(NOT DXC)
  find_program(DXC dxc)
endif()
if(NOT DXC)
  message(FATAL_ERROR "dxc not found. Pass -DDXC=<path to dxc>.")
endif()

get_filename_component(dir "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(out_dir "${dir}/generated")
file(MAKE_DIRECTORY "${out_dir}")
file(GLOB sources "${dir}/*.frag.hlsl")

execute_process(COMMAND "${DXC}" --version OUTPUT_VARIABLE dxc_version OUTPUT_STRIP_TRAILING_WHITESPACE)

# Writes `bytes_file` as a C array named `var` into `header`.
function(write_header bytes_file var header source_name format)
  file(READ "${bytes_file}" hex HEX)
  string(LENGTH "${hex}" hex_len)
  math(EXPR size "${hex_len} / 2")
  # 16 bytes (32 hex digits) per line.
  set(lines "")
  set(offset 0)
  while(offset LESS hex_len)
    string(SUBSTRING "${hex}" ${offset} 32 chunk)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
    string(APPEND lines "    ${chunk}\n")
    math(EXPR offset "${offset} + 32")
  endwhile()
  file(WRITE "${header}"
    "/* Generated by runtime/shaders/compile-shaders.cmake from ${source_name}. Do not edit. */\n"
    "/* Format: ${format}. Compiler: ${dxc_version}. */\n"
    "static const unsigned char ${var}[${size}] = {\n${lines}};\n")
endfunction()

foreach(src IN LISTS sources)
  get_filename_component(name "${src}" NAME)            # rule_wipe.frag.hlsl
  string(REGEX REPLACE "\\.hlsl$" "" base "${name}")     # rule_wipe.frag
  string(REPLACE "." "_" var "${base}")                  # rule_wipe_frag

  set(dxil "${out_dir}/${base}.dxil")
  set(spv "${out_dir}/${base}.spv")

  execute_process(
    # vk:: attributes only matter for SPIR-V; DXIL ignores them.
    COMMAND "${DXC}" -T ps_6_0 -E main -O3 -Wno-ignored-attributes -Fo "${dxil}" "${src}"
    RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "DXIL compile failed: ${name}")
  endif()

  execute_process(
    COMMAND "${DXC}" -spirv -fspv-target-env=vulkan1.0 -T ps_6_0 -E main -O3 -Fo "${spv}" "${src}"
    RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "SPIR-V compile failed: ${name}")
  endif()

  write_header("${dxil}" "${var}_dxil" "${out_dir}/${base}.dxil.h" "${name}" "DXIL ps_6_0")
  write_header("${spv}" "${var}_spv" "${out_dir}/${base}.spv.h" "${name}" "SPIR-V vulkan1.0")
  file(REMOVE "${dxil}" "${spv}")
  message(STATUS "Compiled ${name}")
endforeach()
