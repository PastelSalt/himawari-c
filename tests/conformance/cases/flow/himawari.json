{
  "name": "Conformance: flow",
  "id": "dev.moesoft.conformance.flow",
  "version": "0.1.0",
  "engine": "^1.0.0",
  "entry": "start",
  "sourceLanguage": "en",
  "languages": ["en"],
  "variables": {
    "n": { "type": "int", "default": 7, "scope": "save" },
    "m": { "type": "int", "default": 0, "scope": "save" },
    "zero": { "type": "int", "default": 0, "scope": "save" },
    "z": { "type": "int", "default": 1, "scope": "save" },
    "roll": { "type": "int", "default": 0, "scope": "save" },
    "visits": { "type": "int", "default": 0, "scope": "save" },
    "flag": { "type": "bool", "default": false, "scope": "save" },
    "mood": { "type": "str", "enum": ["calm", "happy"], "default": "calm", "scope": "save" },
    "endings": { "type": "int", "default": 0, "scope": "global" }
  }
}
