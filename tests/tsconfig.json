{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../packages/*/src/**/*.test.ts", "../vitest.config.ts"],
  // Studio's renderer tests use bundler resolution; packages/studio/tsconfig.web.json checks them.
  "exclude": ["../packages/studio/**"]
}
