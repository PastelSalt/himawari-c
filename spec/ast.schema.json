{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pastelsalt.github.io/himawari-c/spec/ast/1.0.json",
  "title": "Himawari Script AST (JSON)",
  "description": "AST version 1.0 for language spec 0.2.0-draft (plan §5.3). Produced by @himawari/core parseAst(); `ast` in its result. Spans are [start, end) offsets in UTF-16 code units. Tools edit scripts through the CST/edit API, never by writing this JSON back.",
  "type": "object",
  "required": ["version", "file", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "file": { "type": "string" },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "name": { "type": "string" },
    "lineId": {
      "description": "6-character Crockford base32 line ID, or null for untagged lines.",
      "oneOf": [{ "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{6}$" }, { "type": "null" }]
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "args"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "args": { "type": "array", "items": { "anyOf": [{ "type": "integer" }, { "type": "string" }] } }
          }
        },
        { "type": "null" }
      ]
    },
    "msOrNull": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
    "strOrNull": { "anyOf": [{ "type": "string" }, { "type": "null" }] },

    "scene": {
      "type": "object",
      "required": ["kind", "id", "span", "body"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Scene" },
        "id": { "$ref": "#/$defs/name" },
        "span": { "$ref": "#/$defs/span" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "body": { "type": "array", "items": { "$ref": "#/$defs/stmt" } },

    "stmt": {
      "oneOf": [
        { "$ref": "#/$defs/say" }, { "$ref": "#/$defs/narration" }, { "$ref": "#/$defs/show" },
        { "$ref": "#/$defs/hide" }, { "$ref": "#/$defs/move" }, { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/audio" }, { "$ref": "#/$defs/stop" }, { "$ref": "#/$defs/wait" },
        { "$ref": "#/$defs/effect" }, { "$ref": "#/$defs/assign" }, { "$ref": "#/$defs/goto" },
        { "$ref": "#/$defs/terminal" }, { "$ref": "#/$defs/if" }, { "$ref": "#/$defs/menu" }
      ]
    },
    "say": {
      "type": "object",
      "required": ["kind", "span", "lineId", "speaker", "attrs", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Say" },
        "span": { "$ref": "#/$defs/span" },
        "lineId": { "$ref": "#/$defs/lineId" },
        "speaker": { "$ref": "#/$defs/name" },
        "attrs": {
          "type": "object",
          "required": ["add", "remove"],
          "additionalProperties": false,
          "properties": {
            "add": { "type": "array", "items": { "$ref": "#/$defs/name" } },
            "remove": { "type": "array", "items": { "$ref": "#/$defs/name" } }
          }
        },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "narration": {
      "type": "object",
      "required": ["kind", "span", "lineId", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Narration" },
        "span": { "$ref": "#/$defs/span" },
        "lineId": { "$ref": "#/$defs/lineId" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "show": {
      "type": "object",
      "required": ["kind", "span", "char", "add", "remove", "at", "transition"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Show" },
        "span": { "$ref": "#/$defs/span" },
        "char": { "$ref": "#/$defs/name" },
        "add": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "remove": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "at": { "$ref": "#/$defs/strOrNull" },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "hide": {
      "type": "object",
      "required": ["kind", "span", "char", "transition"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Hide" },
        "span": { "$ref": "#/$defs/span" },
        "char": { "$ref": "#/$defs/name" },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "move": {
      "type": "object",
      "required": ["kind", "span", "char", "at", "transition"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Move" },
        "span": { "$ref": "#/$defs/span" },
        "char": { "$ref": "#/$defs/name" },
        "at": { "$ref": "#/$defs/strOrNull" },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "image": {
      "type": "object",
      "required": ["kind", "span", "asset", "transition"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["Bg", "Cg"] },
        "span": { "$ref": "#/$defs/span" },
        "asset": { "$ref": "#/$defs/name" },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["kind", "span", "channel", "asset", "fadeMs"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Audio" },
        "span": { "$ref": "#/$defs/span" },
        "channel": { "enum": ["music", "ambient", "sfx", "voice"] },
        "asset": { "$ref": "#/$defs/name" },
        "fadeMs": { "$ref": "#/$defs/msOrNull" }
      }
    },
    "stop": {
      "type": "object",
      "required": ["kind", "span", "channel", "fadeMs"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Stop" },
        "span": { "$ref": "#/$defs/span" },
        "channel": { "type": "string" },
        "fadeMs": { "$ref": "#/$defs/msOrNull" }
      }
    },
    "wait": {
      "type": "object",
      "required": ["kind", "span", "ms"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Wait" },
        "span": { "$ref": "#/$defs/span" },
        "ms": { "$ref": "#/$defs/msOrNull" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["kind", "span", "effect", "ms"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Effect" },
        "span": { "$ref": "#/$defs/span" },
        "effect": { "enum": ["shake", "flash"] },
        "ms": { "$ref": "#/$defs/msOrNull" }
      }
    },
    "assign": {
      "type": "object",
      "required": ["kind", "span", "name", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Assign" },
        "span": { "$ref": "#/$defs/span" },
        "name": { "$ref": "#/$defs/name" },
        "op": { "enum": ["=", "+=", "-=", "*="] },
        "value": { "$ref": "#/$defs/expr" }
      }
    },
    "goto": {
      "type": "object",
      "required": ["kind", "span", "target"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["Jump", "Call"] },
        "span": { "$ref": "#/$defs/span" },
        "target": { "$ref": "#/$defs/name" }
      }
    },
    "terminal": {
      "type": "object",
      "required": ["kind", "span"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["Return", "End"] },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "if": {
      "type": "object",
      "required": ["kind", "span", "clauses"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "If" },
        "span": { "$ref": "#/$defs/span" },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cond", "body"],
            "additionalProperties": false,
            "properties": {
              "cond": { "description": "null for else", "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] },
              "body": { "$ref": "#/$defs/body" }
            }
          }
        }
      }
    },
    "menu": {
      "type": "object",
      "required": ["kind", "span", "prompt", "promptLineId", "options"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Menu" },
        "span": { "$ref": "#/$defs/span" },
        "prompt": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "promptLineId": { "$ref": "#/$defs/lineId" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } }
      }
    },
    "option": {
      "type": "object",
      "required": ["span", "lineId", "once", "text", "cond", "body", "fallsThrough"],
      "additionalProperties": false,
      "properties": {
        "span": { "$ref": "#/$defs/span" },
        "lineId": { "$ref": "#/$defs/lineId" },
        "once": { "type": "boolean" },
        "text": { "$ref": "#/$defs/text" },
        "cond": { "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] },
        "body": { "$ref": "#/$defs/body" },
        "fallsThrough": { "type": "boolean", "description": "true when the body can finish without jump/return/end, so play continues after the menu" }
      }
    },

    "expr": {
      "oneOf": [
        { "type": "object", "required": ["kind", "value"], "additionalProperties": false, "properties": { "kind": { "const": "Int" }, "value": { "type": "integer" } } },
        { "type": "object", "required": ["kind", "value"], "additionalProperties": false, "properties": { "kind": { "const": "Bool" }, "value": { "type": "boolean" } } },
        { "type": "object", "required": ["kind", "value"], "additionalProperties": false, "properties": { "kind": { "const": "Str" }, "value": { "type": "string" } } },
        { "type": "object", "required": ["kind", "name"], "additionalProperties": false, "properties": { "kind": { "const": "Var" }, "name": { "type": "string" } } },
        {
          "type": "object", "required": ["kind", "op", "operand"], "additionalProperties": false,
          "properties": { "kind": { "const": "Unary" }, "op": { "enum": ["-", "not"] }, "operand": { "$ref": "#/$defs/expr" } }
        },
        {
          "type": "object", "required": ["kind", "op", "left", "right"], "additionalProperties": false,
          "properties": {
            "kind": { "const": "Binary" },
            "op": { "enum": ["+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "and", "or"] },
            "left": { "$ref": "#/$defs/expr" },
            "right": { "$ref": "#/$defs/expr" }
          }
        },
        {
          "type": "object", "required": ["kind", "name", "args"], "additionalProperties": false,
          "properties": { "kind": { "const": "Call" }, "name": { "type": "string" }, "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } } }
        },
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "Invalid" } } }
      ]
    },

    "text": { "type": "array", "items": { "$ref": "#/$defs/textPart" } },
    "textPart": {
      "oneOf": [
        { "type": "object", "required": ["t"], "additionalProperties": false, "properties": { "t": { "type": "string" } } },
        { "type": "object", "required": ["var"], "additionalProperties": false, "properties": { "var": { "type": "string" } } },
        {
          "description": "A wrapping tag: b, i, color, size, speed, shake, rb (ruby; value = reading).",
          "type": "object", "required": ["tag", "children"], "additionalProperties": false,
          "properties": { "tag": { "type": "string" }, "value": { "type": "string" }, "children": { "$ref": "#/$defs/text" } }
        },
        {
          "description": "A standalone tag: w, nw, alt.",
          "type": "object", "required": ["tag"], "additionalProperties": false,
          "properties": { "tag": { "type": "string" }, "value": { "type": "string" } }
        },
        {
          "type": "object", "required": ["select", "cases"], "additionalProperties": false,
          "properties": {
            "select": { "type": "string" },
            "cases": { "type": "object", "required": ["other"], "properties": { "other": { "$ref": "#/$defs/text" } }, "additionalProperties": { "$ref": "#/$defs/text" } }
          }
        }
      ]
    }
  }
}
