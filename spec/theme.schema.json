{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pastelsalt.github.io/himawari-c/spec/theme/2.0.json",
  "title": "Himawari theme",
  "description": "theme/theme.json: the built-in UI's look and layout (rfcs/0007, rfcs/0010, spec/language.md §2.9). Core compiles it into the bytecode's THEM section. Asset names have no extension. Percent values are of the screen (one decimal); pixel values are at a 1080-pixel-high screen. Unknown settings are warnings (HW0131).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_/-]*$"
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percent of the screen (one decimal)."
    },
    "px": {
      "type": "integer",
      "description": "Pixels at a 1080-pixel-high screen."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "preset": {
      "enum": [
        "himawari",
        "pastel",
        "minimal",
        "paper",
        "night",
        "retro",
        "high-contrast"
      ],
      "description": "A ready-made look to start from; the other settings override it."
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "dim": {
          "$ref": "#/$defs/color"
        },
        "textbox": {
          "$ref": "#/$defs/color"
        },
        "nameplate": {
          "$ref": "#/$defs/color"
        },
        "choice": {
          "$ref": "#/$defs/color"
        },
        "choice_hover": {
          "$ref": "#/$defs/color"
        },
        "choice_text": {
          "$ref": "#/$defs/color"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "panel": {
          "$ref": "#/$defs/color"
        },
        "outline": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "button": {
          "$ref": "#/$defs/color"
        },
        "button_text": {
          "$ref": "#/$defs/color"
        },
        "title": {
          "$ref": "#/$defs/color"
        }
      },
      "description": "outline: text outlines; border: panel borders; button and button_text: menu buttons; title: the top of the title screen's gradient."
    },
    "textbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percent."
        },
        "height": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60,
          "description": "Percent of the screen height."
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Pixels at the game's resolution."
        },
        "image": {
          "$ref": "#/$defs/asset",
          "description": "A nine-slice image for the textbox."
        },
        "slice": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Nine-slice borders: left, top, right, bottom."
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 12,
          "maximum": 96
        },
        "outline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Text outline in pixels; 0 = none."
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": {
          "$ref": "#/$defs/asset"
        },
        "name": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/asset"
        },
        "music": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "The default for transitions written without a duration."
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Rounded corners, pixels."
        },
        "border": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "shadow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "hover": {
          "enum": [
            "bar",
            "outline",
            "fill"
          ],
          "description": "How a hovered or focused button shows it."
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "$ref": "#/$defs/pct",
              "description": "Left edge, percent."
            },
            "y": {
              "$ref": "#/$defs/pct",
              "description": "Top edge, percent."
            },
            "width": {
              "$ref": "#/$defs/pct"
            },
            "height": {
              "$ref": "#/$defs/pct"
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "$ref": "#/$defs/pct",
              "description": "Left edge, percent."
            },
            "y": {
              "$ref": "#/$defs/pct",
              "description": "Top edge, percent."
            },
            "width": {
              "$ref": "#/$defs/pct"
            },
            "height": {
              "$ref": "#/$defs/pct"
            }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "description": "The text area inside the textbox, pixels from its edges.",
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 400
            },
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "right": {
              "type": "integer",
              "minimum": 0,
              "maximum": 400
            }
          }
        },
        "nameplate": {
          "type": "object",
          "additionalProperties": false,
          "description": "Pixels from the textbox's top-left corner; negative y is above it.",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": -400,
              "maximum": 1600
            },
            "y": {
              "type": "integer",
              "minimum": -300,
              "maximum": 300
            },
            "height": {
              "type": "integer",
              "minimum": 24,
              "maximum": 200
            }
          }
        },
        "choices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "$ref": "#/$defs/pct",
              "description": "Center."
            },
            "y": {
              "$ref": "#/$defs/pct",
              "description": "Center of the list."
            },
            "width": {
              "type": "number",
              "minimum": 10,
              "maximum": 100
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 300
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            }
          }
        },
        "quickbar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "type": "boolean"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            }
          }
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "description": "The game's name on the title screen.",
          "properties": {
            "x": {
              "$ref": "#/$defs/pct"
            },
            "y": {
              "$ref": "#/$defs/pct"
            },
            "size": {
              "type": "integer",
              "minimum": 16,
              "maximum": 200
            },
            "show": {
              "type": "boolean"
            }
          }
        },
        "title_menu": {
          "type": "object",
          "additionalProperties": false,
          "description": "The title screen's buttons.",
          "properties": {
            "x": {
              "$ref": "#/$defs/pct",
              "description": "The column's center, percent."
            },
            "y": {
              "$ref": "#/$defs/pct",
              "description": "The first button's top, percent."
            },
            "width": {
              "type": "integer",
              "minimum": 80,
              "maximum": 1800
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 200
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            }
          }
        },
        "game_menu": {
          "type": "object",
          "additionalProperties": false,
          "description": "The in-game menu's buttons.",
          "properties": {
            "x": {
              "$ref": "#/$defs/pct",
              "description": "The column's center, percent."
            },
            "y": {
              "$ref": "#/$defs/pct",
              "description": "The first button's top, percent."
            },
            "width": {
              "type": "integer",
              "minimum": 80,
              "maximum": 1800
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 200
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "choices": {
          "enum": [
            "none",
            "fade",
            "rise"
          ]
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hover": {
          "$ref": "#/$defs/asset",
          "description": "A sound effect (assets/sfx/)."
        },
        "click": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "strings": {
      "type": "object",
      "description": "Per language, replacements for the built-in UI strings (keys as in @himawari/core THEME_STRING_KEYS).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
