# Your story starts here. Change any line and play it right away.
# Missing art never blocks you: Himawari shows a labeled placeholder instead.

scene start:
    bg school_gate with fade(500)
    show aoi at center with dissolve(300)
    aoi "Hi! I'm Aoi. Welcome to your brand-new visual novel."
    aoi "Everything you see is a placeholder until you add your own art."
    menu "What would you like to do?":
        "Tell me how this works.":
            $ talked_about_engine = true
            aoi "Scenes live in script/, characters in characters/, and pictures and sounds in assets/."
            aoi "Each line of dialogue is one line in the script, like this one."
        "Let's just start.":
            aoi "Great! Open script/start.hws and write your first line."
    if talked_about_engine:
        aoi "Have fun, and come back if you get stuck!"
    else:
        aoi "See you soon!"
    end
